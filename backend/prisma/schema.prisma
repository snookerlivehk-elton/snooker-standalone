// Prisma schema for Snooker master database
// Provider: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums for constrained columns
enum EventType {
  pot
  foul
  miss
  safe
  switch
  newFrame
  concede
  freeBallToggle
}

enum BallName {
  red
  yellow
  green
  brown
  blue
  pink
  black
}

enum MemberRole {
  MEMBER
  ADMIN
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum TournamentSignupStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Member {
  id           String       @id @default(uuid())
  name         String
  // Registration fields
  email        String?      @unique
  // region_code  String?
  district_code String?
  phone        String?
  phone_country String?
  phone_number  String?
  phone_e164    String?     @unique
  phone_verified_at DateTime?
  club_name    String?
  birth_date   DateTime?
  is_guest     Boolean      @default(false)
  role         MemberRole   @default(MEMBER)
  is_enabled   Boolean      @default(true)
  membership_expires_at DateTime?
  access_expires_at DateTime?
  // Authentication
  password_hash String?
  password_salt String?
  password_updated_at DateTime?
  // Member number (code prefix + digits). Using existing member_code for compatibility.
  member_code  String?      @unique
  email_verified_at DateTime?
  email_verification_token String?
  email_verification_expires_at DateTime?
  created_at   DateTime     @default(now())

  matchPlayers MatchPlayer[]
  matchesWon   Match[]      @relation("winner_member")
  matchesOperated Match[]   @relation("match_operator")
  rooms        Room[]
  breakRecords BreakRecord[]
  createdBreakRecords BreakRecord[] @relation("break_created_by")
  
  // Club Relationship (If this member is a Club/Operator)
  clubProfile  ClubProfile?
  
  // Club Membership (If this member joined clubs)
  joinedClubs  ClubMember[]

  reservations TableReservation[]
  liveAnnouncements LiveAnnouncement[]

  pointsLedgers PointsLedger[]
  pointsBalances PointsBalance[]
  createdPointsLedgers PointsLedger[] @relation("points_created_by")

  startedTableSessions TableSession[] @relation("table_session_started_by")
  endedTableSessionsAsMember TableSession[] @relation("table_session_ended_by_member")
  endedTableSessionsAsOperator TableSession[] @relation("table_session_ended_by_operator")

  tournamentSignups TournamentSignup[]
}

model ClubProfile {
  id          String   @id @default(uuid())
  memberId    String   @unique
  member      Member   @relation(fields: [memberId], references: [id])
  
  name        String?
  intro       String?
  address     String?
  mapUrl      String?
  phone       String?
  email       String?
  logoUrl     String?
  paymentInfo String?
  coverImageUrl String?
  galleryUrls Json?
  facilities  Json?
  policies    String?
  
  members     ClubMember[]
  messages    ClubMessage[]
  breakRecords BreakRecord[]
  liveAnnouncements LiveAnnouncement[]
  tournaments Tournament[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tables      ClubTable[]
  pricing     TablePricingScheme[]
  reservations TableReservation[]

  pointsConfig ClubPointsConfig?
  pointsLedgers PointsLedger[]
  pointsBalances PointsBalance[]

  tableQrTokens TableQrToken[]
  tableSessions TableSession[]
}

model BreakRecord {
  id                  String      @id @default(uuid())
  club_id             String
  member_id           String
  points              Int
  recorded_at         DateTime    @default(now())
  video_url           String?
  note                String?
  created_at          DateTime    @default(now())
  created_by_member_id String
  updated_at          DateTime?
  updated_by_admin    String?
  deleted_at          DateTime?
  deleted_by_admin    String?
  delete_reason       String?

  club                ClubProfile @relation(fields: [club_id], references: [id])
  member              Member      @relation(fields: [member_id], references: [id])
  created_by          Member      @relation("break_created_by", fields: [created_by_member_id], references: [id])

  @@index([club_id, recorded_at])
  @@index([member_id, recorded_at])
  @@index([club_id, member_id, recorded_at])
  @@index([club_id, points])
  @@index([deleted_at])
}

model ClubMessage {
  id        String   @id @default(uuid())
  clubId    String
  club      ClubProfile @relation(fields: [clubId], references: [id])
  title     String?
  content   String
  createdAt DateTime @default(now())
}

model LiveAnnouncement {
  id                String   @id @default(uuid())
  clubId            String
  club              ClubProfile @relation(fields: [clubId], references: [id])
  title             String
  startsAt          DateTime
  liveUrl           String
  createdByMemberId String
  createdBy         Member @relation(fields: [createdByMemberId], references: [id])
  createdAt         DateTime @default(now())
  deletedAt         DateTime?

  @@index([clubId, startsAt])
  @@index([startsAt])
  @@index([deletedAt])
}

model Tournament {
  id          String   @id @default(uuid())
  clubId      String
  club        ClubProfile @relation(fields: [clubId], references: [id])
  status      TournamentStatus @default(DRAFT)
  title       String
  description String?
  capacity    Int      @default(32)
  startsAt    DateTime?
  signupOpensAt DateTime?
  signupClosesAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  signups     TournamentSignup[]

  @@index([clubId, status])
  @@index([clubId, startsAt])
}

model TournamentSignup {
  id           String   @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id])
  status       TournamentSignupStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tournamentId, memberId])
  @@index([memberId, createdAt])
  @@index([tournamentId, createdAt])
  @@index([status])
}

model SiteNotice {
  id              String   @id @default("main")
  enabled         Boolean  @default(true)
  message         String   @default("")
  youtubeEmbedUrl String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model ClubPointsConfig {
  id              String   @id @default(uuid())
  clubId          String   @unique
  club            ClubProfile @relation(fields: [clubId], references: [id])
  currencyCode    String   @default("HKD")
  pointsPerCurrency Decimal @default(1)
  roundingMinutes Int      @default(15)
  minBillableMinutes Int   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PointsLedger {
  id               String   @id @default(uuid())
  clubId           String
  club             ClubProfile @relation(fields: [clubId], references: [id])
  memberId         String
  member           Member   @relation(fields: [memberId], references: [id])
  deltaPoints      Int
  reason           String
  refType          String?
  refId            String?
  createdByMemberId String
  createdBy        Member   @relation("points_created_by", fields: [createdByMemberId], references: [id])
  createdAt        DateTime @default(now())
  @@index([clubId, createdAt])
  @@index([memberId, createdAt])
  @@index([clubId, memberId, createdAt])
}

model PointsBalance {
  id        String   @id @default(uuid())
  clubId    String
  club      ClubProfile @relation(fields: [clubId], references: [id])
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([clubId, memberId])
  @@index([clubId])
  @@index([memberId])
}

model ClubMember {
  id        String   @id @default(uuid())
  clubId    String
  memberId  String
  joinedAt  DateTime @default(now())
  
  club      ClubProfile @relation(fields: [clubId], references: [id])
  member    Member      @relation(fields: [memberId], references: [id])

  @@unique([clubId, memberId])
}

// Sequence table for district-based member code generation (legacy, kept for compatibility)
model MemberSequence {
  district_code String   @id
  next_seq      Int      @default(1)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model MemberRegion {
  code3   String           @id
  name    String
  active  Boolean          @default(true)
  districts MemberDistrict[]
}

model MemberDistrict {
  id          String        @id @default(uuid())
  region_code String
  code3       String
  name        String
  active      Boolean       @default(true)
  
  region      MemberRegion  @relation(fields: [region_code], references: [code3])

  @@unique([region_code, code3], name: "region_code_code3")
}

model MemberCodeSequence {
  region_code   String
  district_code String
  next_seq      Int      @default(1)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@id([region_code, district_code])
}

model RoomCodeSequence {
  id         Int      @id @default(1)
  last_code  String   @default("AAAAA0000")
  updated_at DateTime @updatedAt
}

model Room {
  id          String   @id // e.g. AAAAA0001
  name        String?
  code        String?
  operator_id String?
  operator    Member?  @relation(fields: [operator_id], references: [id])
  created_at  DateTime @default(now())
  // No expiration field, we will just query created_at for cleanup
  gameState   Json?
  scores      Json?
  
  matches     Match[]
  @@index([operator_id])
}

model Match {
  id               String       @id @default(uuid())
  room_id          String
  room             Room?        @relation(fields: [room_id], references: [id])
  name             String
  name_part        String?
  match_key_normalized String?
  match_code       String?
  frames_required  Int
  red_balls        Int
  handicap0        Int          @default(0)
  handicap1        Int          @default(0)
  started_at       DateTime?
  ended_at         DateTime?
  version          Int          @default(1)

  // winner relation
  winner_member_id String?
  winner_member    Member?      @relation(name: "winner_member", fields: [winner_member_id], references: [id])

  players          MatchPlayer[]
  events           Event[]
  foulTotals       FoulTotals?
  stats            MatchStats?

  // Operator (who recorded the match)
  operator_id      String?
  operator         Member?      @relation(name: "match_operator", fields: [operator_id], references: [id])

  @@index([started_at])
  @@index([winner_member_id])
  @@index([room_id])
  @@index([match_key_normalized])
}

model MatchPlayer {
  id                String   @id @default(uuid())
  match_id          String
  member_id         String

  match             Match    @relation(fields: [match_id], references: [id], onDelete: Cascade)
  member            Member   @relation(fields: [member_id], references: [id])

  frames_won        Int      @default(0)
  total_points      Int      @default(0)
  pot_rate          Decimal  @default(0)
  avg_shot_time_ms  Int      @default(0)
  avg_break_time_ms Int      @default(0)
  max_break_time_ms Int      @default(0)
  break_count       Int      @default(0)
  max_break_points  Int      @default(0)
  foul_count        Int      @default(0)
  quick_shot_rate   Decimal  @default(0)
  safe_success_rate Decimal  @default(0)
  pot_by_ball       Json     @db.JsonB
  shot_time_buckets Json     @db.JsonB

  @@index([match_id, member_id])
  @@index([member_id])
  @@unique([match_id, member_id], name: "match_id_member_id")
}

model Event {
  id                BigInt     @id @default(autoincrement())
  match_id          String

  match             Match      @relation(fields: [match_id], references: [id], onDelete: Cascade)
  idx               Int
  type              EventType
  player_index      Int
  player_member_id  String
  ball_name         BallName?
  points            Int?
  timestamp         BigInt?
  shot_time_ms      Int?

  @@index([match_id, idx])
  @@index([match_id, timestamp])
}

model FoulTotals {
  match_id      String  @id
  match         Match   @relation(fields: [match_id], references: [id], onDelete: Cascade)
  player0_total Int     @default(0)
  player1_total Int     @default(0)
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  BLOCKED
  CANCELLED
}

model ClubTable {
  id            String   @id @default(uuid())
  clubId        String
  club          ClubProfile @relation(fields: [clubId], references: [id])
  name          String
  basePrice     Decimal?
  active        Boolean  @default(true)
  displayOrder  Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  reservations  TableReservation[]
  pricingSchemes TablePricingScheme[]
  qrToken       TableQrToken?
  sessions      TableSession[]
  @@index([clubId, active])
}

enum TableSessionStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum TableSessionEndSource {
  MEMBER
  OPERATOR
}

enum TableSessionConfirmAction {
  START
  END
}

model TableQrToken {
  id        String   @id @default(uuid())
  token     String   @unique
  clubId    String
  club      ClubProfile @relation(fields: [clubId], references: [id])
  tableId   String   @unique
  table     ClubTable @relation(fields: [tableId], references: [id])
  active    Boolean  @default(true)
  rotatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([clubId])
}

model TableSession {
  id               String   @id @default(uuid())
  clubId           String
  club             ClubProfile @relation(fields: [clubId], references: [id])
  tableId          String
  table            ClubTable @relation(fields: [tableId], references: [id])
  startedByMemberId String
  startedBy        Member   @relation("table_session_started_by", fields: [startedByMemberId], references: [id])
  startAt          DateTime @default(now())
  status           TableSessionStatus @default(ACTIVE)
  endAt            DateTime?
  endedByMemberId  String?
  endedByMember    Member?  @relation("table_session_ended_by_member", fields: [endedByMemberId], references: [id])
  endedByOperatorId String?
  endedByOperator  Member?  @relation("table_session_ended_by_operator", fields: [endedByOperatorId], references: [id])
  endSource        TableSessionEndSource?
  billedMinutes    Int?
  chargedAmount    Decimal?
  chargedCurrency  String?
  chargedPoints    Int?
  pointsLedgerId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([clubId, status])
  @@index([tableId, status])
  @@index([startedByMemberId, startAt])
}

model TableSessionConfirm {
  id        String   @id @default(uuid())
  action    TableSessionConfirmAction
  token     String
  clubId    String
  tableId   String
  memberId  String
  sessionId String?
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([memberId, createdAt])
  @@index([token, createdAt])
  @@index([expiresAt])
}

model TablePricingScheme {
  id            String   @id @default(uuid())
  clubId        String
  club          ClubProfile @relation(fields: [clubId], references: [id])
  tableId       String?
  table         ClubTable? @relation(fields: [tableId], references: [id])
  title         String
  description   String?
  price         Decimal?
  rulesJson     Json
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  reservations  TableReservation[]
  @@index([clubId, active])
  @@index([tableId])
}

model TableReservation {
  id              String   @id @default(uuid())
  clubId          String
  club            ClubProfile @relation(fields: [clubId], references: [id])
  tableId         String
  table           ClubTable @relation(fields: [tableId], references: [id])
  memberId        String
  member          Member @relation(fields: [memberId], references: [id])
  status          ReservationStatus @default(PENDING)
  startAt         DateTime
  endAt           DateTime
  pricingSchemeId String?
  pricingScheme   TablePricingScheme? @relation(fields: [pricingSchemeId], references: [id])
  priceQuote      Decimal?
  createdAt       DateTime @default(now())
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  @@index([clubId, startAt])
  @@index([tableId, startAt])
}

model MatchStats {
  match_id     String  @id
  match        Match   @relation(fields: [match_id], references: [id], onDelete: Cascade)
  events_count Int     @default(0)
  per_player   Json    @db.JsonB
}

model EmailVerification {
  id         String   @id @default(uuid())
  email      String
  code       String
  purpose    String
  created_at DateTime @default(now())
  expires_at DateTime
  used_at    DateTime?
  attempts   Int      @default(0)
  ip         String?

  @@index([email])
  @@index([email, purpose])
}
