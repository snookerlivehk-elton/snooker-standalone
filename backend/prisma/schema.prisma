// Prisma schema for Snooker master database
// Provider: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  MEMBER
  ADMIN
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum TournamentSignupStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Member {
  id           String       @id @default(uuid())
  name         String
  // Registration fields
  email        String?      @unique
  region_code  String?
  district_code String?
  public_highbreak_enabled Boolean @default(false)
  phone        String?
  phone_country String?
  phone_number  String?
  phone_e164    String?     @unique
  phone_verified_at DateTime?
  club_name    String?
  birth_date   DateTime?
  is_guest     Boolean      @default(false)
  role         MemberRole   @default(MEMBER)
  is_enabled   Boolean      @default(true)
  membership_expires_at DateTime?
  access_expires_at DateTime?
  // Authentication
  password_hash String?
  password_salt String?
  password_updated_at DateTime?
  // Member number (code prefix + digits). Using existing member_code for compatibility.
  member_code  String?      @unique
  email_verified_at DateTime?
  email_verification_token String?
  email_verification_expires_at DateTime?
  created_at   DateTime     @default(now())

  matchPlayers MatchPlayer[]
  matchesWon   Match[]      @relation("winner_member")
  matchesOperated Match[]   @relation("match_operator")
  breakRecords BreakRecord[]
  createdBreakRecords BreakRecord[] @relation("break_created_by")
  
  // Club Relationship (If this member is a Club/Operator)
  clubProfile  ClubProfile?
  
  // Club Membership (If this member joined clubs)
  joinedClubs  ClubMember[]

  reservations TableReservation[]
  liveAnnouncements LiveAnnouncement[]

  pointsLedgers PointsLedger[]
  pointsBalances PointsBalance[]
  createdPointsLedgers PointsLedger[] @relation("points_created_by")

  startedTableSessions TableSession[] @relation("table_session_started_by")
  endedTableSessionsAsMember TableSession[] @relation("table_session_ended_by_member")
  endedTableSessionsAsOperator TableSession[] @relation("table_session_ended_by_operator")

  tournamentSignups TournamentSignup[]
  settlements SessionSettlement[]
}

model ClubProfile {
  id          String   @id @default(uuid())
  memberId    String   @unique
  member      Member   @relation(fields: [memberId], references: [id])
  
  name        String?
  intro       String?
  address     String?
  mapUrl      String?
  phone       String?
  email       String?
  logoUrl     String?
  paymentInfo String?
  coverImageUrl String?
  galleryUrls Json?
  facilities  Json?
  policies    String?
  publicEnabled Boolean @default(false)
  publicShowHighbreak Boolean @default(true)
  publicShowTournaments Boolean @default(true)
  publicShowLive Boolean @default(true)
  
  members     ClubMember[]
  messages    ClubMessage[]
  breakRecords BreakRecord[]
  liveAnnouncements LiveAnnouncement[]
  tournaments Tournament[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tables      ClubTable[]
  pricing     TablePricingScheme[]
  reservations TableReservation[]

  pointsConfig ClubPointsConfig?
  pointsLedgers PointsLedger[]
  pointsBalances PointsBalance[]
  moduleConfigs ClubModuleConfig[]

  tableQrTokens TableQrToken[]
  tableSessions TableSession[]
  featureAccesses ClubFeatureAccess[]
  settlements SessionSettlement[]
}

model BreakRecord {
  id                  String      @id @default(uuid())
  club_id             String
  member_id           String
  points              Int
  recorded_at         DateTime    @default(now())
  video_url           String?
  note                String?
  created_at          DateTime    @default(now())
  created_by_member_id String
  updated_at          DateTime?
  updated_by_admin    String?
  deleted_at          DateTime?
  deleted_by_admin    String?
  delete_reason       String?

  club                ClubProfile @relation(fields: [club_id], references: [id])
  member              Member      @relation(fields: [member_id], references: [id])
  created_by          Member      @relation("break_created_by", fields: [created_by_member_id], references: [id])

  @@index([club_id, recorded_at])
  @@index([member_id, recorded_at])
  @@index([club_id, member_id, recorded_at])
  @@index([club_id, points])
  @@index([deleted_at])
}

model ClubMessage {
  id        String   @id @default(uuid())
  clubId    String
  club      ClubProfile @relation(fields: [clubId], references: [id])
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([clubId, createdAt])
  @@index([clubId, deletedAt])
}

model LiveAnnouncement {
  id                String   @id @default(uuid())
  clubId            String
  club              ClubProfile @relation(fields: [clubId], references: [id])
  title             String
  startsAt          DateTime
  liveUrl           String
  createdByMemberId String
  createdBy         Member @relation(fields: [createdByMemberId], references: [id])
  createdAt         DateTime @default(now())
  deletedAt         DateTime?

  @@index([clubId, startsAt])
  @@index([startsAt])
  @@index([deletedAt])
}

model Tournament {
  id          String   @id @default(uuid())
  clubId      String
  club        ClubProfile @relation(fields: [clubId], references: [id])
  status      TournamentStatus @default(DRAFT)
  title       String
  description String?
  signupGuide String?
  capacity    Int      @default(32)
  startsAt    DateTime?
  signupOpensAt DateTime?
  signupClosesAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  signups     TournamentSignup[]

  @@index([clubId, status])
  @@index([clubId, startsAt])
}

model TournamentSignup {
  id           String   @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id])
  status       TournamentSignupStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tournamentId, memberId])
  @@index([memberId, createdAt])
  @@index([tournamentId, createdAt])
  @@index([status])
}

model SiteNotice {
  id              String   @id @default("main")
  enabled         Boolean  @default(true)
  message         String   @default("")
  youtubeEmbedUrl String?
  homeShowLeaderboard Boolean @default(true)
  homeShowClubList Boolean @default(true)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model SiteAd {
  id                String   @id
  enabled           Boolean  @default(true)
  imageUrl          String?
  linkUrl           String?
  displaySeconds    Int      @default(15)
  minIntervalMinutes Int     @default(20)
  maxIntervalMinutes Int     @default(30)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

model SiteAdItem {
  id        String   @id @default(uuid())
  enabled   Boolean  @default(true)
  imageUrl  String?
  linkUrl   String?
  title     String?
  subtitle  String?
  ctaLabel  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  placements SiteAdPlacementItem[]
}

model SiteAdPlacementItem {
  id        String   @id @default(uuid())
  placement String
  itemId    String
  enabled   Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item SiteAdItem @relation(fields: [itemId], references: [id])

  @@unique([placement, itemId])
  @@index([placement, sort])
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model ClubFeatureAccess {
  id         String      @id @default(uuid())
  clubId      String
  club        ClubProfile @relation(fields: [clubId], references: [id])
  featureKey String
  enabled    Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([clubId, featureKey])
  @@index([featureKey, enabled])
}

model SystemModule {
  code                   String   @id
  name                   String
  description            String?
  category               String
  pluginId               String?
  defaultEnabled         Boolean  @default(true)
  supportsClubAssignment Boolean  @default(false)
  supportsPublicRoutes   Boolean  @default(false)
  supportsHomeSection    Boolean  @default(false)
  supportsVenueAdmin     Boolean  @default(false)
  supportsSuperAdmin     Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  config      SystemModuleConfig?
  clubConfigs ClubModuleConfig[]
}

model SystemModuleConfig {
  moduleCode      String   @unique
  module          SystemModule @relation(fields: [moduleCode], references: [code], onDelete: Cascade)
  enabledGlobally Boolean  @default(true)
  publicVisible   Boolean  @default(false)
  homeVisible     Boolean  @default(false)
  allowClubEnable Boolean  @default(false)
  sortOrder       Int      @default(0)
  settingsJson    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ClubModuleConfig {
  id             String   @id @default(uuid())
  clubId         String
  club           ClubProfile @relation(fields: [clubId], references: [id])
  moduleCode     String
  module         SystemModule @relation(fields: [moduleCode], references: [code], onDelete: Cascade)
  enabledForClub Boolean  @default(false)
  publicVisible  Boolean  @default(false)
  settingsJson   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([clubId, moduleCode])
  @@index([moduleCode, enabledForClub])
  @@index([clubId, enabledForClub])
}

model AppLock {
  key        String   @id
  lockedUntil DateTime?
  lockedBy   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model NewsSource {
  id                 String   @id
  name               String
  feedUrl            String
  siteUrl            String?
  enabled            Boolean  @default(true)
  language           String?
  region             String?
  fetchEveryHours    Int      @default(72)
  lastFetchAttemptAt DateTime?
  lastFetchedAt      DateTime?
  lastError          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items    NewsItem[]
  fetchLogs NewsFetchLog[]

  @@index([enabled, lastFetchedAt])
}

model NewsItem {
  id          String      @id @default(uuid())
  sourceId    String
  source      NewsSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title       String
  url         String      @unique
  publishedAt DateTime?
  author      String?
  summary     String?
  imageUrl    String?
  tags        Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([sourceId, publishedAt])
  @@index([publishedAt])
}

model NewsFetchLog {
  id         String     @id @default(uuid())
  sourceId   String
  source     NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  ok         Boolean    @default(false)
  newCount   Int        @default(0)
  error      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([sourceId, startedAt])
  @@index([startedAt])
}

model ClubPointsConfig {
  id              String   @id @default(uuid())
  clubId          String   @unique
  club            ClubProfile @relation(fields: [clubId], references: [id])
  currencyCode    String   @default("HKD")
  pointsPerCurrency Decimal @default(1)
  roundingMinutes Int      @default(15)
  minBillableMinutes Int   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PointsLedger {
  id               String   @id @default(uuid())
  clubId           String
  club             ClubProfile @relation(fields: [clubId], references: [id])
  memberId         String
  member           Member   @relation(fields: [memberId], references: [id])
  deltaPoints      Int
  reason           String
  refType          String?
  refId            String?
  createdByMemberId String
  createdBy        Member   @relation("points_created_by", fields: [createdByMemberId], references: [id])
  createdAt        DateTime @default(now())
  @@index([clubId, createdAt])
  @@index([memberId, createdAt])
  @@index([clubId, memberId, createdAt])
}

model PointsBalance {
  id        String   @id @default(uuid())
  clubId    String
  club      ClubProfile @relation(fields: [clubId], references: [id])
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([clubId, memberId])
  @@index([clubId])
  @@index([memberId])
}

model ClubMember {
  id        String   @id @default(uuid())
  clubId    String
  memberId  String
  joinedAt  DateTime @default(now())
  rating    Int      @default(0)
  nickname  String?
  
  club      ClubProfile @relation(fields: [clubId], references: [id])
  member    Member      @relation(fields: [memberId], references: [id])

  @@unique([clubId, memberId])
}

// Sequence table for district-based member code generation (legacy, kept for compatibility)
model MemberSequence {
  district_code String   @id
  next_seq      Int      @default(1)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model MemberRegion {
  code3   String           @id
  name    String
  active  Boolean          @default(true)
  districts MemberDistrict[]
}

model MemberDistrict {
  id          String        @id @default(uuid())
  region_code String
  code3       String
  name        String
  active      Boolean       @default(true)
  
  region      MemberRegion  @relation(fields: [region_code], references: [code3])

  @@unique([region_code, code3], name: "region_code_code3")
}

model MemberCodeSequence {
  region_code   String
  district_code String
  next_seq      Int      @default(1)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@id([region_code, district_code])
}

model Match {
  id               String       @id @default(uuid())
  room_id          String
  name             String
  name_part        String?
  match_key_normalized String?
  match_code       String?
  frames_required  Int
  red_balls        Int
  handicap0        Int          @default(0)
  handicap1        Int          @default(0)
  started_at       DateTime?
  ended_at         DateTime?
  version          Int          @default(1)

  // winner relation
  winner_member_id String?
  winner_member    Member?      @relation(name: "winner_member", fields: [winner_member_id], references: [id])

  players          MatchPlayer[]

  // Operator (who recorded the match)
  operator_id      String?
  operator         Member?      @relation(name: "match_operator", fields: [operator_id], references: [id])

  @@index([started_at])
  @@index([winner_member_id])
  @@index([match_key_normalized])
}

model MatchPlayer {
  id                String   @id @default(uuid())
  match_id          String
  member_id         String

  match             Match    @relation(fields: [match_id], references: [id], onDelete: Cascade)
  member            Member   @relation(fields: [member_id], references: [id])

  frames_won        Int      @default(0)
  total_points      Int      @default(0)
  pot_rate          Decimal  @default(0)
  avg_shot_time_ms  Int      @default(0)
  avg_break_time_ms Int      @default(0)
  max_break_time_ms Int      @default(0)
  break_count       Int      @default(0)
  max_break_points  Int      @default(0)
  foul_count        Int      @default(0)
  quick_shot_rate   Decimal  @default(0)
  safe_success_rate Decimal  @default(0)
  pot_by_ball       Json     @db.JsonB
  shot_time_buckets Json     @db.JsonB

  @@index([match_id, member_id])
  @@index([member_id])
  @@unique([match_id, member_id], name: "match_id_member_id")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  BLOCKED
  CANCELLED
}

model ClubTable {
  id            String   @id @default(uuid())
  clubId        String
  club          ClubProfile @relation(fields: [clubId], references: [id])
  name          String
  basePrice     Decimal?
  active        Boolean  @default(true)
  displayOrder  Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  reservations  TableReservation[]
  pricingSchemes TablePricingScheme[]
  qrToken       TableQrToken?
  sessions      TableSession[]
  @@index([clubId, active])
}

enum TableSessionStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum TableSessionEndSource {
  MEMBER
  OPERATOR
}

enum TableSessionConfirmAction {
  START
  END
}

enum SettlementPaymentMethod {
  POINTS
  MANUAL
  CASH
  WALLET
  PACKAGE
}

enum SettlementStatus {
  PENDING
  QUOTED
  AWAITING_CONFIRMATION
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model TableQrToken {
  id        String   @id @default(uuid())
  token     String   @unique
  clubId    String
  club      ClubProfile @relation(fields: [clubId], references: [id])
  tableId   String   @unique
  table     ClubTable @relation(fields: [tableId], references: [id])
  active    Boolean  @default(true)
  rotatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([clubId])
}

model TableSession {
  id               String   @id @default(uuid())
  clubId           String
  club             ClubProfile @relation(fields: [clubId], references: [id])
  tableId          String
  table            ClubTable @relation(fields: [tableId], references: [id])
  startedByMemberId String
  startedBy        Member   @relation("table_session_started_by", fields: [startedByMemberId], references: [id])
  startAt          DateTime @default(now())
  status           TableSessionStatus @default(ACTIVE)
  endAt            DateTime?
  endedByMemberId  String?
  endedByMember    Member?  @relation("table_session_ended_by_member", fields: [endedByMemberId], references: [id])
  endedByOperatorId String?
  endedByOperator  Member?  @relation("table_session_ended_by_operator", fields: [endedByOperatorId], references: [id])
  endSource        TableSessionEndSource?
  billedMinutes    Int?
  chargedAmount    Decimal?
  chargedCurrency  String?
  chargedPoints    Int?
  pointsLedgerId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  settlement       SessionSettlement?
  @@index([clubId, status])
  @@index([tableId, status])
  @@index([startedByMemberId, startAt])
}

model TableSessionConfirm {
  id        String   @id @default(uuid())
  action    TableSessionConfirmAction
  token     String
  clubId    String
  tableId   String
  memberId  String
  sessionId String?
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([memberId, createdAt])
  @@index([token, createdAt])
  @@index([expiresAt])
}

model SessionSettlement {
  id              String   @id @default(uuid())
  sessionId       String   @unique
  session         TableSession @relation(fields: [sessionId], references: [id])
  clubId          String
  club            ClubProfile @relation(fields: [clubId], references: [id])
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id])
  tableId         String
  paymentMethod   SettlementPaymentMethod?
  status          SettlementStatus @default(PENDING)
  durationMinutes Int?
  billableMinutes Int?
  baseAmount      Decimal?
  chargedAmount   Decimal?
  chargedCurrency String?
  quotePayload    Json?
  pointsLedgerId  String?
  confirmedAt     DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attempts        SessionSettlementAttempt[]

  @@index([clubId, status, createdAt])
  @@index([memberId, status, createdAt])
  @@index([tableId, createdAt])
}

model SessionSettlementAttempt {
  id              String   @id @default(uuid())
  settlementId    String
  settlement      SessionSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  providerKey     String
  status          String
  requestPayload  Json?
  responsePayload Json?
  failureReason   String?
  createdAt       DateTime @default(now())

  @@index([settlementId, createdAt])
  @@index([providerKey, createdAt])
}

model DomainEventOutbox {
  id            String   @id @default(uuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  createdAt     DateTime @default(now())
  processedAt   DateTime?
  failedAt      DateTime?

  @@index([eventType, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([processedAt, failedAt])
}

model TablePricingScheme {
  id            String   @id @default(uuid())
  clubId        String
  club          ClubProfile @relation(fields: [clubId], references: [id])
  tableId       String?
  table         ClubTable? @relation(fields: [tableId], references: [id])
  title         String
  description   String?
  price         Decimal?
  rulesJson     Json
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  reservations  TableReservation[]
  @@index([clubId, active])
  @@index([tableId])
}

model TableReservation {
  id              String   @id @default(uuid())
  clubId          String
  club            ClubProfile @relation(fields: [clubId], references: [id])
  tableId         String
  table           ClubTable @relation(fields: [tableId], references: [id])
  memberId        String
  member          Member @relation(fields: [memberId], references: [id])
  status          ReservationStatus @default(PENDING)
  startAt         DateTime
  endAt           DateTime
  pricingSchemeId String?
  pricingScheme   TablePricingScheme? @relation(fields: [pricingSchemeId], references: [id])
  priceQuote      Decimal?
  createdAt       DateTime @default(now())
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  @@index([clubId, startAt])
  @@index([tableId, startAt])
}

model EmailVerification {
  id         String   @id @default(uuid())
  email      String
  code       String
  purpose    String
  created_at DateTime @default(now())
  expires_at DateTime
  used_at    DateTime?
  attempts   Int      @default(0)
  ip         String?

  @@index([email])
  @@index([email, purpose])
}
